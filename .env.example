# Protects encrypted user and database-managed system keys. Use a long random
# secret in deployment; changing it makes previously saved keys unreadable.
RAG_KEY_ENCRYPTION_KEY=replace_with_a_long_random_secret
ADMIN_PASSWORD=replace_with_a_strong_admin_password

# System key pools accept comma-separated keys. Singular variables also work.
OPENAI_API_KEYS=
GROQ_API_KEYS=
GEMINI_API_KEYS=
ANTHROPIC_API_KEYS=
OPENROUTER_API_KEYS=
OX_ALPHA_API_KEYS=

# Optional JSON alternative, for example:
# RAG_SYSTEM_KEYS_JSON={"openai":["key-1","key-2"],"groq":["key-1"]}
RAG_SYSTEM_KEYS_JSON={}

# Backward-compatible singular variables.
GROQ_API_KEY=
TAVILY_API_KEY=your_tavily_api_key_here
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
PDF_VISION_OCR_MAX_PAGES=12
PDF_VISION_OCR_DPI=160
# Set to true to spend an extra model call expanding each retrieval query.
RAG_QUERY_EXPANSION=false
RAG_RATE_LIMIT_COOLDOWN_SECONDS=90
RAG_QUOTA_COOLDOWN_SECONDS=900
RAG_PROVIDER_COOLDOWN_SECONDS=30
